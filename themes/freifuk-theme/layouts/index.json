{{- $pages := where site.RegularPages "Type" "posts" -}}
{{- $items := slice -}}
{{- range $pages -}}
  {{- $items = $items | append (dict
    "title" .Title
    "summary" .Summary
    "content" .Plain
    "permalink" .RelPermalink
    "date" .Date
    "section" .Section
    "tags" .Params.tags
    "categories" .Params.categories
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
